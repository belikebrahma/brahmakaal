# Brahmakaal Environment Configuration
# Copy to .env and fill in your values

# Database (required)
DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# Redis Cache (required)
REDIS_ENABLED=true
REDIS_URL=rediss://user:pass@host:6379/0

# Application
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Ephemeris
EPHEMERIS_FILE_PATH=de421.bsp

# JWT (auto-generated with random key if empty)
JWT_SECRET_KEY=
